{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "s" }],
      "destination": "/api/share"
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
