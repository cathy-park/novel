{
  "regions": ["icn1"],
  "rewrites": [
    {
      "source": "/share",
      "destination": "/api/share"
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
